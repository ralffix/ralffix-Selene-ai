{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "run-script",
          "cmd": "sh",
          "sidecar": false,
          "args": [
            "-c",
            { "validator": ".*", "raw": true }
          ]
        },
        {
          "name": "run-bash",
          "cmd": "bash",
          "sidecar": false,
          "args": [
            "-l",
            "-c",
            { "validator": ".*", "raw": true }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "run-script",
          "cmd": "sh",
          "sidecar": false,
          "args": [
            "-c",
            { "validator": ".*", "raw": true }
          ]
        }
      ]
    },
    "shell:allow-kill"
  ]
}
